<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>KAAPAV ARC Studio Control Room</title>
  <style>
    :root{--bg:#070914;--glass:rgba(18,22,42,.62);--line:rgba(255,255,255,.1);--text:#f4f6ff;--muted:#9ca6bf;--cyan:#5de4ff;--violet:#aa7cff;--green:#65f2ac;--amber:#ffc96b;--red:#ff7085;--shadow:0 22px 80px rgba(0,0,0,.35)}
    *{box-sizing:border-box} html{scroll-behavior:smooth} body{margin:0;min-height:100vh;color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:radial-gradient(circle at 12% 8%,rgba(96,84,255,.22),transparent 32%),radial-gradient(circle at 88% 18%,rgba(0,201,255,.16),transparent 30%),radial-gradient(circle at 55% 95%,rgba(169,88,255,.14),transparent 30%),var(--bg);background-attachment:fixed}
    body:before{content:"";position:fixed;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);background-size:42px 42px;mask-image:linear-gradient(to bottom,black,transparent 85%)}
    .shell{width:min(1440px,calc(100% - 32px));margin:auto;padding:24px 0 48px}.glass{background:var(--glass);border:1px solid var(--line);box-shadow:var(--shadow);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border-radius:22px}
    header{display:flex;align-items:center;gap:16px;padding:17px 20px;position:sticky;top:12px;z-index:10}.mark{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,var(--violet),var(--cyan));font-weight:900;color:#080a14;letter-spacing:-1px}.logo{width:44px;height:44px;border-radius:14px;object-fit:cover;display:block}.brand{flex:1}.brand h1{font-size:17px;line-height:1.1;margin:0}.brand p{margin:4px 0 0;color:var(--muted);font-size:12px}.live{display:flex;align-items:center;gap:10px}.dot{width:9px;height:9px;border-radius:99px;background:var(--muted);box-shadow:0 0 18px currentColor}.dot.green{background:var(--green)}.dot.amber{background:var(--amber)}.dot.red{background:var(--red)}.dot.blue{background:var(--cyan)}.pill{padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.045);font-size:12px;font-weight:800;letter-spacing:.08em}.updated{color:var(--muted);font-size:11px;text-align:right}
    .hero{margin-top:18px;padding:28px;display:grid;grid-template-columns:1.7fr 1fr;gap:24px;overflow:hidden;position:relative}.hero:after{content:"";position:absolute;width:300px;height:300px;border-radius:50%;right:-120px;top:-160px;background:var(--cyan);filter:blur(90px);opacity:.1}.eyebrow{color:var(--cyan);text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:800}.hero h2{font-size:clamp(30px,5vw,58px);line-height:1;margin:9px 0 14px;letter-spacing:-.045em}.hero p{max-width:760px;margin:0;color:#c7cde0;font-size:15px}.next{padding:18px;border-radius:17px;background:rgba(255,255,255,.05);border:1px solid var(--line);align-self:stretch;display:flex;flex-direction:column;justify-content:center}.label{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.12em}.next strong{display:block;font-size:18px;margin-top:8px}.next span{color:var(--muted);margin-top:5px}
    nav{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:16px 0;padding:7px}.tab{border:0;border-radius:14px;padding:12px;background:transparent;color:var(--muted);cursor:pointer;font-weight:750}.tab:hover{color:var(--text);background:rgba(255,255,255,.04)}.tab.active{color:var(--text);background:linear-gradient(135deg,rgba(170,124,255,.25),rgba(93,228,255,.14));box-shadow:inset 0 0 0 1px rgba(255,255,255,.09)}
    .panel{display:none}.panel.active{display:block}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}.card{grid-column:span 3;padding:19px;min-height:128px}.card.wide{grid-column:span 6}.card.full{grid-column:1/-1}.metric{font-size:29px;font-weight:850;letter-spacing:-.035em;margin:8px 0 0}.sub{color:var(--muted);font-size:12px}.accent{color:var(--cyan)}.good{color:var(--green)}.warn{color:var(--amber)}.bad{color:var(--red)}
    .progress{height:7px;background:rgba(255,255,255,.07);border-radius:99px;overflow:hidden;margin-top:14px}.bar{height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,var(--violet),var(--cyan));transition:width .5s ease}.section-title{display:flex;justify-content:space-between;align-items:end;margin:4px 0 13px}.section-title h3{margin:0;font-size:15px}.section-title span{color:var(--muted);font-size:11px}
    table{width:100%;border-collapse:collapse}th{text-align:left;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em;padding:10px 12px;border-bottom:1px solid var(--line)}td{padding:12px;border-bottom:1px solid rgba(255,255,255,.055);vertical-align:top}tr:last-child td{border-bottom:0}.table-wrap{overflow:auto;max-height:520px}.state{font-size:10px;padding:5px 8px;border-radius:8px;background:rgba(255,255,255,.06);white-space:nowrap}.state.public,.state.passed,.state.ready{color:var(--green);background:rgba(101,242,172,.1)}.state.scheduled,.state.running{color:var(--cyan);background:rgba(93,228,255,.1)}.state.paused_safe,.state.paused{color:var(--amber);background:rgba(255,201,107,.1)}
    .series-row{display:grid;grid-template-columns:minmax(170px,1.3fr) 2fr 66px;gap:14px;align-items:center;padding:12px 0;border-bottom:1px solid rgba(255,255,255,.055)}.series-row:last-child{border:0}.series-name{font-weight:700}.series-name small{display:block;color:var(--muted);font-weight:400}.series-value{text-align:right;color:var(--muted)}
    .timeline{display:grid;gap:9px}.event{display:grid;grid-template-columns:92px 1fr;gap:12px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.05)}.event:last-child{border:0}.event time{color:var(--muted);font-size:11px}.event strong{font-size:12px}.empty{padding:22px;text-align:center;color:var(--muted);border:1px dashed var(--line);border-radius:14px}
    .tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.tag{font-size:9px;padding:3px 6px;border-radius:6px;color:#cbd4ea;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.06)}
    .button{border:1px solid rgba(93,228,255,.28);color:#061018;background:linear-gradient(135deg,var(--cyan),#9ff4ff);font-weight:850;padding:10px 14px;border-radius:11px;cursor:pointer}.button:disabled{opacity:.45;cursor:not-allowed}.button.secondary{color:var(--text);background:rgba(255,255,255,.06);border-color:var(--line)}.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.filter{border:1px solid var(--line);color:var(--text);background:rgba(9,12,25,.75);padding:9px 11px;border-radius:10px;min-width:150px;outline:none}.filter:focus{border-color:rgba(93,228,255,.5)}.notice{border-left:3px solid var(--amber);padding:12px 14px;background:rgba(255,201,107,.07);border-radius:4px 12px 12px 4px;color:#e8dcc6}.kv{display:grid;grid-template-columns:160px 1fr;gap:7px 16px}.kv dt{color:var(--muted)}.kv dd{margin:0;overflow-wrap:anywhere}.chart{height:220px;width:100%;margin-top:12px}.chart polyline{fill:none;stroke:var(--cyan);stroke-width:2.5;vector-effect:non-scaling-stroke}.chart .gridline{stroke:rgba(255,255,255,.08);stroke-width:1}.legend{display:flex;gap:14px;color:var(--muted);font-size:11px}.footer{padding:20px 4px;color:var(--muted);font-size:11px;text-align:center}
    @media(max-width:900px){.hero{grid-template-columns:1fr}.card{grid-column:span 6}.card.wide{grid-column:1/-1}.updated{display:none}.series-row{grid-template-columns:1fr}.series-value{text-align:left}nav{overflow:auto;grid-template-columns:repeat(5,minmax(112px,1fr))}}
    @media(max-width:560px){.shell{width:min(100% - 18px,1440px);padding-top:9px}header{top:7px}.brand p{display:none}.card{grid-column:1/-1}.hero{padding:21px}.live .pill{display:none}.kv{grid-template-columns:1fr}.event{grid-template-columns:1fr}}

    /* KAAPAV colourful neumorphism — shared visual language with the Flutter app. */
    :root{--bg:#e8eef7;--glass:#e8eef7;--line:#cbd6e6;--text:#20283a;--muted:#71809b;--cyan:#18b8c9;--violet:#675cf5;--green:#24b77a;--amber:#f59d17;--red:#ed5968;--pink:#ff5ea8;--shadow:9px 9px 20px #b9c5d8,-9px -9px 20px #fff}
    body{color:var(--text);background:linear-gradient(145deg,#eef4fc 0%,#e5ecf6 55%,#edf2fa 100%);background-attachment:fixed}
    body:before{opacity:.9;background:radial-gradient(circle at 8% 7%,rgba(103,92,245,.18),transparent 24%),radial-gradient(circle at 94% 13%,rgba(255,94,168,.14),transparent 24%),radial-gradient(circle at 70% 92%,rgba(24,184,201,.14),transparent 25%);mask-image:none}
    .glass{background:var(--glass);border:0;box-shadow:var(--shadow);backdrop-filter:none;-webkit-backdrop-filter:none}
    header{border-left:5px solid var(--violet)}
    .mark{color:#fff;background:linear-gradient(135deg,var(--violet),var(--pink));box-shadow:0 10px 24px rgba(103,92,245,.32)}.logo{box-shadow:0 10px 24px rgba(240,160,40,.28);border:1px solid rgba(240,180,60,.35)}
    .pill{border:0;background:#e8eef7;box-shadow:inset 3px 3px 7px #c4cede,inset -3px -3px 7px #fff}
    .hero{border-left:5px solid var(--pink)}
    .hero:after{background:linear-gradient(135deg,var(--pink),var(--cyan));filter:blur(80px);opacity:.16}
    .hero p{color:#56647d}.eyebrow{color:var(--violet)}
    .next{background:#e8eef7;border:0;box-shadow:inset 6px 6px 13px #c4cede,inset -6px -6px 13px #fff}
    nav{background:#e8eef7}
    .tab{color:var(--muted);transition:.18s ease}
    .tab:hover{color:var(--violet);background:rgba(255,255,255,.3)}
    .tab.active{color:var(--violet);background:#dfe7f2;box-shadow:inset 5px 5px 10px #bdc8d9,inset -5px -5px 10px #fff}
    .card{position:relative;overflow:hidden}
    .card:before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:var(--violet);border-radius:22px 0 0 22px}
    .grid>.card:nth-child(5n+2):before{background:var(--pink)}
    .grid>.card:nth-child(5n+3):before{background:var(--cyan)}
    .grid>.card:nth-child(5n+4):before{background:var(--amber)}
    .grid>.card:nth-child(5n+5):before{background:var(--green)}
    .metric{color:var(--text)}
    .progress{height:9px;background:#d3dce9;box-shadow:inset 2px 2px 5px #bcc7d8,inset -2px -2px 5px #fff}
    .bar{background:linear-gradient(90deg,var(--violet),var(--pink),var(--cyan))}
    th{color:var(--muted);border-bottom:1px solid #cbd6e6}td{border-bottom:1px solid #d1dae7}tr:hover td{background:rgba(255,255,255,.28)}
    .series-row,.event{border-bottom-color:#d1dae7}
    .state{background:#dce4ef}.state.public,.state.passed,.state.ready{background:rgba(36,183,122,.12)}.state.scheduled,.state.running{background:rgba(24,184,201,.12)}.state.paused_safe,.state.paused{background:rgba(245,157,23,.12)}
    .tag{color:#596983;background:#dce4ef;border:0;box-shadow:inset 1px 1px 3px #c1cbd9,inset -1px -1px 3px #fff}
    .filter{border:0;color:var(--text);background:#e8eef7;box-shadow:inset 4px 4px 8px #c4cede,inset -4px -4px 8px #fff}
    .filter:focus{box-shadow:inset 4px 4px 8px #c4cede,inset -4px -4px 8px #fff,0 0 0 2px rgba(103,92,245,.25)}
    .button{border:0;color:#fff;background:linear-gradient(135deg,var(--violet),var(--pink));box-shadow:5px 5px 11px #bdc8d9,-5px -5px 11px #fff}.button.secondary{color:var(--violet);background:#e8eef7}
    .notice{color:#72551e;background:rgba(245,157,23,.1)}
    .chart .gridline{stroke:#cbd6e6}.empty{border-color:#bdc9da}.footer{color:#71809b}
    .control-card{display:flex;align-items:center;justify-content:space-between;gap:22px;border-left:5px solid var(--green)}.control-card.disabled{border-left-color:var(--amber)}
    .power-button{min-width:190px;border:0;border-radius:18px;padding:15px 20px;color:#fff;font-weight:900;cursor:pointer;box-shadow:6px 6px 14px #bdc8d9,-6px -6px 14px #fff;transition:transform .15s ease}.power-button:hover{transform:translateY(-2px)}.power-button.enable{background:linear-gradient(135deg,#20b879,#5fd7a7)}.power-button.disable{background:linear-gradient(135deg,#ed5968,#ff8b72)}.power-button:disabled{opacity:.55;cursor:wait;transform:none}
    @media(max-width:700px){.control-card{align-items:stretch;flex-direction:column}.power-button{width:100%}}
    .platform-control-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.platform-control{padding:18px;border-radius:18px;background:#e8eef7;box-shadow:inset 4px 4px 9px #c4cede,inset -4px -4px 9px #fff}.platform-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.platform-head strong{text-transform:capitalize;font-size:17px}.platform-toggle{border:0;border-radius:12px;padding:9px 12px;color:#fff;font-weight:850;cursor:pointer}.platform-toggle.on{background:linear-gradient(135deg,var(--red),var(--pink))}.platform-toggle.off{background:linear-gradient(135deg,var(--green),var(--cyan))}.platform-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:14px}.platform-stats span{font-size:10px;color:var(--muted)}.platform-stats b{display:block;font-size:16px;color:var(--text)}
    @media(max-width:760px){.platform-control-grid{grid-template-columns:1fr}}
    .stage-strip{display:grid;grid-template-columns:repeat(10,1fr);gap:10px;margin:18px 0 10px}
    .stage{position:relative;padding:12px;border-radius:14px;background:#e8eef7;box-shadow:inset 3px 3px 7px #c4cede,inset -3px -3px 7px #fff;border:1px solid #d1dae7}
    .stage-count{font-size:22px;font-weight:900;color:var(--text)}
    .stage-bar{height:7px;border-radius:99px;background:#d3dce9;box-shadow:inset 1px 1px 3px #bcc7d8,inset -1px -1px 3px #fff;margin:8px 0;overflow:hidden}
    .stage-bar>div{height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--violet),var(--pink),var(--cyan))}
    .stage-label{font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .stage-top{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:24px;margin-top:6px}
    .stage-top .metric{margin:0;min-width:120px}
    .series-row{cursor:pointer;transition:.15s ease;border-radius:10px}
    .series-row:hover{background:rgba(255,255,255,.35)}
    @media(max-width:900px){.stage-strip{grid-template-columns:repeat(5,1fr)}}
    @media(max-width:560px){.stage-strip{grid-template-columns:repeat(2,1fr)}}
  </style>
</head>
<body>
<main class="shell">
  <header class="glass">
    <div class="mark"><img class="logo" src="logo.png" alt="KAAPAV ARC Studios"></div><div class="brand"><h1>KAAPAV ARC Studio Control Room</h1><p>Automation, production, releases and real audience evidence</p></div>
    <div class="live"><span id="statusDot" class="dot"></span><span id="statusPill" class="pill">CONNECTING</span><span id="updated" class="updated">Waiting for data</span></div>
  </header>

  <section class="hero glass">
    <div><div class="eyebrow">Studio state</div><h2 id="heroMode">Loading…</h2><p id="heroSummary">Reading the verified local control plane.</p></div>
    <div class="next"><div class="label">Next exact action</div><strong id="nextAction">Checking queue</strong><span id="nextDetail">—</span></div>
  </section>

  <nav class="glass" aria-label="Dashboard sections">
    <button class="tab active" data-tab="overview">Overview</button><button class="tab" data-tab="production">Production</button><button class="tab" data-tab="releases">Releases</button><button class="tab" data-tab="performance">Performance</button><button class="tab" data-tab="system">System</button>
  </nav>

  <section id="overview" class="panel active"><div id="overviewGrid" class="grid"></div></section>
  <section id="production" class="panel"><div id="productionGrid" class="grid"></div></section>
  <section id="releases" class="panel"><div id="releasesGrid" class="grid"></div></section>
  <section id="performance" class="panel"><div id="performanceGrid" class="grid"></div></section>
  <section id="system" class="panel"><div id="systemGrid" class="grid"></div></section>
  <div class="footer">Secure owner dashboard · Auto-refreshes every 5 seconds · Automation control enabled</div>
</main>
<script>
const $=s=>document.querySelector(s), esc=v=>String(v??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=v=>new Intl.NumberFormat('en-IN').format(Number(v||0));
const when=v=>{if(!v)return'—';const d=new Date(v);return isNaN(d)?esc(v):d.toLocaleString('en-IN',{timeZone:'Asia/Kolkata',dateStyle:'medium',timeStyle:'short'})+' IST'};
const pct=(a,b)=>Math.min(100,Math.round(100*Number(a||0)/Math.max(1,Number(b||0))));
const badge=v=>`<span class="state ${esc(String(v||'').toLowerCase())}">${esc(v||'unknown')}</span>`;
const card=(label,value,sub='',wide='')=>`<article class="card glass ${wide}"><div class="label">${esc(label)}</div><div class="metric">${esc(value)}</div><div class="sub">${esc(sub)}</div></article>`;
function activateTab(name){const button=document.querySelector(`.tab[data-tab="${name}"]`);if(!button)return;document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));button.classList.add('active');$('#'+name).classList.add('active');history.replaceState(null,'','#'+name)}
function tabs(){document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>activateTab(b.dataset.tab));const requested=location.hash.slice(1);if(requested)activateTab(requested)}
async function controlAutomation(enable){const warning=enable?'Enable zero-touch automation and start the next production cycle now?':'Disable automation, close the production gate, and stop the current scheduled cycle?';if(!confirm(warning))return;const button=$('#automationControlButton');if(button)button.disabled=true;try{const response=await fetch('/api/autopilot-control',{method:'POST',headers:{'Content-Type':'application/json','X-KAAPAV-Control':'confirmed'},body:JSON.stringify({action:enable?'enable':'disable'})});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||'Control action failed');await load()}catch(error){alert(`Automation control failed: ${error.message}`);if(button)button.disabled=false}}
async function controlPlatform(name,enable){const action=enable?'enable':'disable';if(!confirm(`${action.toUpperCase()} ${name} automation? The global QC gate remains enforced.`))return;try{const response=await fetch('/api/platform-control',{method:'POST',headers:{'Content-Type':'application/json','X-KAAPAV-Control':'confirmed'},body:JSON.stringify({platform:name,action})});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.detail||result.error||'Platform control failed');await load()}catch(error){alert(`${name} control failed: ${error.message}`)}}
function platformCard(name,p){const enabled=Boolean(p?.enabled),health=p?.health||'unknown';return `<div class="platform-control"><div class="platform-head"><div><strong>${esc(name)}</strong><div>${badge(health)}</div></div><button class="platform-toggle ${enabled?'on':'off'}" data-platform="${esc(name)}" data-enable="${enabled?'0':'1'}">${enabled?'Disable':'Enable'}</button></div><p class="sub">${esc(p?.detail||p?.reason||'No status yet')}</p><div class="platform-stats"><span>Queued<b>${num(p?.queued)}</b></span><span>Published<b>${num(p?.published)}</b></span><span>Issues<b>${num(p?.failures)}</b></span></div>${p?.next_publish_at?`<div class="sub">Next: ${when(p.next_publish_at)}</div>`:''}</div>`}
function renderOverview(d){const o=d.overview,s=d.studio,disabled=Boolean(s.pause_file),platforms=d.platforms||{};$('#overviewGrid').innerHTML=`<article class="card full glass control-card ${disabled?'disabled':''}"><div><div class="eyebrow">Owner control</div><div class="metric">Automation ${disabled?'disabled':'enabled'}</div><div class="sub">${disabled?'Production is safely paused. Enable starts the next supervised cycle immediately.':'Zero-touch production is active. Disable closes the gate and stops the scheduled cycle.'}</div></div><button id="automationControlButton" class="power-button ${disabled?'enable':'disable'}">${disabled?'▶ Enable automation':'■ Disable automation'}</button></article>`+`<article class="card full glass"><div class="section-title"><h3>Platform controls</h3><span>Independent health and release switches</span></div><div class="platform-control-grid">${['youtube','facebook','instagram'].map(name=>platformCard(name,platforms[name])).join('')}</div></article>`+card('Certification',String(o.certification||'unknown').replaceAll('_',' ').toUpperCase(),o.certification_failures.length?'Attention required':'All verified checks passed')+card('Story universe',`${num(o.series)} series`,`${num(o.episode_manifests)} episodes · ${num(o.scene_scripts)} scenes`)+card('Image production',`${num(o.images_complete)} / ${num(o.images_total)}`,`${o.image_progress_percent}% complete`)+card('Release state',`${num(o.public_videos)} public`,`${num(o.scheduled_videos)} scheduled`)+`<article class="card wide glass"><div class="section-title"><h3>Two-week buffer</h3><span>${num(o.ready_buffer)} of ${num(o.buffer_target)} ready</span></div><div class="metric">${pct(o.ready_buffer,o.buffer_target)}%</div><div class="progress"><div class="bar" style="width:${pct(o.ready_buffer,o.buffer_target)}%"></div></div><p class="sub">A gap or failed QC blocks later episodes. The system cannot jump ahead.</p></article>`+`<article class="card wide glass"><div class="section-title"><h3>What is happening?</h3>${badge(s.mode)}</div><p>${esc(s.summary)}</p><div class="notice">Production gate: <strong>${disabled?'CLOSED — owner pause':'OPEN'}</strong></div></article>`;$('#automationControlButton').onclick=()=>controlAutomation(disabled);document.querySelectorAll('.platform-toggle').forEach(button=>button.onclick=()=>controlPlatform(button.dataset.platform,button.dataset.enable==='1'))}
function renderProduction(d){
  const p=d.production;
  const stages=[['identities_pending','Identities'],['images_pending','Story frames'],['image_qc_pending','Visual QC'],['render_ready','Render'],['technical_qc_pending','Tech QC'],['strict_audit_pending','Strict audit'],['strict_audit_passed','Audit passed'],['private_uploaded','Private upload'],['scheduled','Scheduled'],['public','Live']];
  const activeSeries=p.series.find(x=>Number(x.sequence)===Number(p.active_series_sequence));
  let pipeline='';
  if(activeSeries){
    const st=activeSeries.states||{},total=Math.max(1,activeSeries.episodes),pastGate=total-Number(st.identities_pending||0),gatePct=Math.round(100*pastGate/total);
    const cells=stages.map(([s,label])=>{const c=Number(st[s]||0),w=Math.round(100*c/total);return `<div class="stage" title="${label}"><div class="stage-count">${num(c)}</div><div class="stage-bar"><div style="width:${w}%"></div></div><div class="stage-label">${label}</div></div>`}).join('');
    pipeline=`<article class="card full glass"><div class="section-title"><h3>Production pipeline</h3><span>Series #${num(activeSeries.sequence)} · ${esc(activeSeries.title||activeSeries.series_id)}</span></div><div class="stage-top"><div class="metric">${gatePct}%</div><div><div class="progress"><div class="bar" style="width:${gatePct}%"></div></div><p class="sub">${num(pastGate)} of ${num(activeSeries.episodes)} episodes past the identities gate · buffer shortage ${num(p.shortage)}</p></div></div><div class="stage-strip">${cells}</div><p class="sub">Sequential stages — a blocked QC holds everything behind it. Click any series below to drill into its episodes.</p></article>`;
  }
  const series=p.series.map(x=>`<div class="series-row" onclick="drillSeries('${esc(x.series_id)}')" title="Click to see this series' episodes"><div class="series-name">${esc(x.sequence)}. ${esc(x.title)}<small>${esc(x.series_id)}</small></div><div><div class="progress"><div class="bar" style="width:${x.progress_percent}%"></div></div><small class="sub">${num(x.release_ready)} of ${num(x.episodes)} release-ready/public</small></div><div class="series-value">${x.progress_percent}%</div></div>`).join('');
  const queue=p.queue.slice(0,12).map(x=>`<tr><td>${num(x.priority)}</td><td><strong>${esc(x.episode_title||'Untitled episode')}</strong><div class="sub">${esc(x.series_id)} · Episode ${num(x.episode)}</div></td><td>${badge(x.action)}</td><td>${esc(x.blocker||'Ready when gate opens')}</td></tr>`).join('');
  const ev=p.events.slice(0,10).map(x=>`<div class="event"><time>${when(x.at||x.timestamp)}</time><div><strong>${esc(x.event||x.type||'event')}</strong><div class="sub">${esc(x.key||x.series_id||'')}</div></div></div>`).join('');
  const seriesOptions=p.series.map(x=>`<option value="${esc(x.series_id)}" ${Number(x.sequence)===Number(p.active_series_sequence)?'selected':''}>${esc(x.title)}</option>`).join('');
  const states=[...new Set((p.episodes||[]).map(x=>x.state))].sort().map(x=>`<option value="${esc(x)}">${esc(String(x).replaceAll('_',' '))}</option>`).join('');
  $('#productionGrid').innerHTML=pipeline+card('Active series',`#${num(p.active_series_sequence)}`,`Buffer shortage: ${num(p.shortage)}`)+card('Queued tasks',num(p.queue.length),'Strict priority order')+card('Active failures',num(p.failures.length),p.failures.length?'Recovery/backoff visible':'No quarantined failures')+card('Pipeline states',num(Object.keys(p.state_counts).length),'Every episode has one authoritative state')+`<article class="card full glass"><div class="section-title"><h3>All series</h3><span>Click a series to see its episodes</span></div>${series||'<div class="empty">No inventory found</div>'}</article>`+`<article class="card wide glass"><div class="section-title"><h3>Next production queue</h3><span>Series, episode name, number and exact stage</span></div><div class="table-wrap"><table><thead><tr><th>#</th><th>Episode</th><th>Action</th><th>Blocker</th></tr></thead><tbody>${queue||'<tr><td colspan="4"><div class="empty">Queue empty</div></td></tr>'}</tbody></table></div></article>`+`<article class="card wide glass"><div class="section-title"><h3>Recent automation events</h3><span>Newest first</span></div><div class="timeline">${ev||'<div class="empty">No events recorded</div>'}</div></article>`+`<article class="card full glass"><div class="section-title"><h3>Complete episode pipeline</h3><span id="episodeCount">300 episodes</span></div><div class="actions"><select id="seriesFilter" class="filter"><option value="all">All series</option>${seriesOptions}</select><select id="stateFilter" class="filter"><option value="all">All pipeline states</option>${states}</select><input id="episodeSearch" class="filter" placeholder="Search episode name or number"></div><div class="table-wrap"><table><thead><tr><th>Series</th><th>Episode</th><th>Pipeline status</th><th>Blocker / schedule</th></tr></thead><tbody id="episodePipelineRows"></tbody></table></div></article>`;
  const apply=()=>{const sf=$('#seriesFilter').value,st=$('#stateFilter').value,q=$('#episodeSearch').value.toLowerCase().trim();const filtered=(p.episodes||[]).filter(x=>(sf==='all'||x.series_id===sf)&&(st==='all'||x.state===st)&&(!q||`${x.episode} ${x.episode_title} ${x.series_title}`.toLowerCase().includes(q)));$('#episodeCount').textContent=`Showing ${filtered.length} of ${(p.episodes||[]).length}`;$('#episodePipelineRows').innerHTML=filtered.map(x=>`<tr><td><strong>${esc(x.series_title)}</strong><div class="sub">${esc(x.series_id)}</div></td><td><strong>Episode ${num(x.episode)}</strong><div class="sub">${esc(x.episode_title)}</div></td><td>${badge(x.state)}</td><td>${esc(x.blocker||'No blocker')}${x.publish_at?`<div class="sub">${when(x.publish_at)}</div>`:''}</td></tr>`).join('')||'<tr><td colspan="4"><div class="empty">No episodes match this filter</div></td></tr>'};
  $('#seriesFilter').onchange=apply;$('#stateFilter').onchange=apply;$('#episodeSearch').oninput=apply;window.__applyEpisodes=apply;apply();
}
function drillSeries(id){const sf=$('#seriesFilter');if(!sf)return;sf.value=id;if(window.__applyEpisodes)window.__applyEpisodes();sf.scrollIntoView({behavior:'smooth',block:'center'})}
function renderReleases(d){const r=d.releases,rec=r.reconciliation||{};let rows=r.videos.map(x=>`<tr><td><strong>${esc(x.title)}</strong><div class="sub">${esc(x.series_id||'legacy')} ${x.episode?'· Ep '+esc(x.episode):''}</div></td><td>${badge(x.privacy)}${x.remote_publish_at?'<div class="sub">'+when(x.remote_publish_at)+'</div>':''}</td><td>${num(x.views)}</td><td>${num(x.likes)}</td><td>${num(x.comments)}</td><td><a class="accent" href="${esc(x.url)}" target="_blank" rel="noreferrer">Open</a></td></tr>`).join('');$('#releasesGrid').innerHTML=card('Remote contract',String(rec.status||'unknown').toUpperCase(),`${num((rec.checks||[]).length)} videos checked`)+card('Public',num(r.counts.public||0),'Live on channel')+card('Private',num(r.counts.private||0),'Includes future schedules')+card('Mismatches',num((rec.failures||[]).length),'Any mismatch blocks further scheduling')+`<article class="card full glass"><div class="section-title"><h3>YouTube releases</h3><span>Live API snapshot</span></div><div class="table-wrap"><table><thead><tr><th>Video</th><th>Status / schedule</th><th>Views</th><th>Likes</th><th>Comments</th><th></th></tr></thead><tbody>${rows||'<tr><td colspan="6"><div class="empty">No releases found</div></td></tr>'}</tbody></table></div></article>`}
function renderMetaReleases(d){const r=d.releases||{},items=r.meta||[],queue=r.meta_queue||{};const rows=items.map(x=>`<tr><td><strong>${esc(x.platform)}</strong><div class="sub">${esc(x.series_id)} · Episode ${num(x.episode)}</div></td><td>${badge(x.status)}</td><td>${when(x.published_at)}</td><td>${x.url?`<a class="accent" href="${esc(x.url)}" target="_blank" rel="noreferrer">Open</a>`:'—'}</td></tr>`).join('');$('#releasesGrid').insertAdjacentHTML('beforeend',card('Facebook queue',num(queue.facebook?.queued),`${num(queue.facebook?.failures)} issues`)+card('Instagram queue',num(queue.instagram?.queued),`${num(queue.instagram?.failures)} issues`)+card('Facebook published',num(queue.facebook?.published),'Meta ledger')+card('Instagram published',num(queue.instagram?.published),'Meta ledger')+`<article class="card full glass"><div class="section-title"><h3>Facebook & Instagram releases</h3><span>Separate platform evidence</span></div><div class="table-wrap"><table><thead><tr><th>Platform / episode</th><th>Status</th><th>Published</th><th></th></tr></thead><tbody>${rows||'<tr><td colspan="4"><div class="empty">No Meta releases yet. Future audited episodes will appear here.</div></td></tr>'}</tbody></table></div></article>`)}
function retentionChart(videos){const found=Object.values(videos||{}).find(v=>Array.isArray(v.retention_curve)&&v.retention_curve.length);if(!found)return'<div class="empty">Retention curve will appear after Analytics permission and sufficient YouTube data.</div>';const pts=found.retention_curve.map(p=>[Number(p.elapsedVideoTimeRatio||0),Number(p.audienceWatchRatio||0)]).filter(p=>Number.isFinite(p[0])&&Number.isFinite(p[1]));if(!pts.length)return'<div class="empty">No retention curve available yet.</div>';const max=Math.max(1,...pts.map(p=>p[1]));const line=pts.map(p=>`${(p[0]*100).toFixed(1)},${(100-p[1]/max*92).toFixed(1)}`).join(' ');return`<svg class="chart" viewBox="0 0 100 100" preserveAspectRatio="none"><line class="gridline" x1="0" y1="25" x2="100" y2="25"/><line class="gridline" x1="0" y1="50" x2="100" y2="50"/><line class="gridline" x1="0" y1="75" x2="100" y2="75"/><polyline points="${line}"/></svg><div class="legend"><span>0% start</span><span>100% end</span></div>`}
async function auth(path){const b=$('#analyticsButton');b.disabled=true;await fetch(path,{method:'POST'});setTimeout(load,1000)}
function renderPerformance(d){const p=d.performance,a=p.youtube_analytics||{},az=p.analytics_authorization||{},processRunning=p.authorization_process?.running,remote=d.access?.mode==='remote_read_only';const ready=a.status==='ok'||az.status==='ready';const workflowRunning=processRunning||['awaiting_owner_consent','validating_channel','testing_analytics_api','waiting_for_api_enable'].includes(az.status);let eps=p.episodes.map(x=>{const tags=(x.tags||[]).map(t=>`<span class="tag">${esc(t)}</span>`).join('');const traits=Object.entries(x.traits||{}).map(([k,v])=>`${k.replaceAll('_',' ')}: ${v.replaceAll('_',' ')}`).join(' · ');return`<tr><td><strong>${esc(x.episode_title||x.title)}</strong><div class="sub">${esc(x.series_id||'legacy')} · Episode ${esc(x.episode||'—')}</div><div class="tags">${tags}</div></td><td>${num(x.views)}<div class="sub">${num(x.engaged_views)} engaged</div></td><td>${x.average_view_percentage==null?'—':Number(x.average_view_percentage).toFixed(1)+'%'}<div class="sub">${x.average_view_duration==null?'—':Number(x.average_view_duration).toFixed(1)+' sec avg'}</div></td><td>${(Number(x.like_rate||0)*100).toFixed(1)}% likes<div class="sub">${(Number(x.comment_rate||0)*100).toFixed(1)}% comments</div></td><td>${badge(x.learning_eligibility)}<div class="sub">${esc(x.evidence_window_hours?x.evidence_window_hours+'h window':x.diagnosis)}</div></td><td><span class="sub">${esc(traits||'Traits unavailable')}</span></td></tr>`}).join('');let tagRows=(p.tag_performance||[]).map(x=>`<tr><td>${esc(x.tag)}</td><td>${num(x.samples)}</td><td>${num(x.views)}</td><td>${x.mean_score}</td><td>${badge(x.status)}</td></tr>`).join('');$('#performanceGrid').innerHTML=card('Subscribers',num(p.channel.subscribers),p.channel.title)+card('Channel views',num(p.channel.channel_views),'Current Data API total')+card('Learning samples',num(p.learning.observations),`${num(p.learning.minimum_samples)} required before exploitation`)+card('Evidence windows',num(p.learning.window_snapshots),'24h · 72h · 168h preserved')+`<article class="card wide glass"><div class="section-title"><h3>YouTube retention analytics</h3>${badge(ready?'ready':workflowRunning?'running':a.status||az.status||'setup required')}</div><p>${esc(ready?'Real watch duration, average percentage and audience-retention curves are active.':az.detail||a.detail||'One-time Google authorization is required.')}</p>${remote?'<div class="notice">Remote dashboard is read-only. Analytics controls remain local-only.</div>':(!ready?'<div class="notice">Google requires one owner consent. After that, collection is fully unattended.</div>':'')}<div class="actions"><button id="analyticsButton" class="button" ${workflowRunning||remote?'disabled':''}>${remote?'Local-only control':workflowRunning?'Authorization in progress…':ready?'Retest Analytics':'Enable Retention Analytics'}</button>${az.enable_url&&!remote?`<a class="button secondary" href="${esc(az.enable_url)}" target="_blank" rel="noreferrer">Open Google API page</a>`:''}</div></article>`+`<article class="card wide glass"><div class="section-title"><h3>Latest retention curve</h3><span>Real API data only</span></div>${retentionChart(a.videos)}</article>`+`<article class="card full glass"><div class="section-title"><h3>Episode-wise performance</h3><span>Name, number, tags, packaging traits and evidence status</span></div><div class="table-wrap"><table><thead><tr><th>Series / episode</th><th>Views</th><th>Retention</th><th>Engagement</th><th>Learning</th><th>Packaging traits</th></tr></thead><tbody>${eps||'<tr><td colspan="6"><div class="empty">No episode data yet</div></td></tr>'}</tbody></table></div></article>`+`<article class="card full glass"><div class="section-title"><h3>Tag performance</h3><span>Directional only after comparable organic samples</span></div>${tagRows?`<div class="table-wrap"><table><thead><tr><th>Tag</th><th>Samples</th><th>Views</th><th>Mean score</th><th>Confidence</th></tr></thead><tbody>${tagRows}</tbody></table></div>`:'<div class="empty">No tag is labelled successful yet. Owner-test episodes are excluded and future tags need comparable organic samples.</div>'}</article>`;if(!remote)$('#analyticsButton').onclick=()=>auth(ready?'/api/analytics-test':'/api/analytics-authorize')}
const renderPerformanceOwnerAware=renderPerformance;
renderPerformance=d=>renderPerformanceOwnerAware(String(d.access?.mode||'').startsWith('remote')?{...d,access:{...d.access,mode:'remote_read_only'}}:d);
const renderPerformanceDistributionAware=renderPerformance;
renderPerformance=d=>{renderPerformanceDistributionAware(d);const episodes=d.performance?.episodes||[];const feed=episodes.reduce((sum,x)=>sum+Number(x.shorts_feed_views||0),0);const engaged=episodes.reduce((sum,x)=>sum+Number(x.shorts_feed_engaged_views||0),0);const observed=episodes.filter(x=>x.organic_distribution_status==='shorts_feed_observed').length;$('#performanceGrid').insertAdjacentHTML('afterbegin',card('Shorts Feed exposure',num(feed),`${num(engaged)} engaged · ${num(observed)} episodes tested by Feed`)+`<article class="card wide glass"><div class="section-title"><h3>Organic distribution truth</h3>${badge(observed?'feed observed':'waiting')}</div><p>${observed?'YouTube Shorts Feed traffic is confirmed from real Analytics source data.':'No Shorts Feed distribution is recorded yet. Owner/direct views are not treated as organic reach.'}</p><div class="sub">Per-episode traffic sources include Shorts Feed, Search, Related/Suggested, Playlist, Channel and external traffic when YouTube returns them.</div></article>`)};
function renderMetaPerformance(d){const meta=d.performance?.meta_analytics||{},platforms=meta.platforms||{},learning=d.performance?.platform_learning?.platforms||{};$('#performanceGrid').insertAdjacentHTML('beforeend',`<article class="card full glass"><div class="section-title"><h3>Platform performance & learning</h3>${badge(meta.status||'waiting')}</div><div class="platform-control-grid">${['facebook','instagram'].map(name=>{const p=platforms[name]||{},l=learning[name]||{},meaningful=(l.observations||[]).filter(x=>x.meaningful).length;return `<div class="platform-control"><div class="platform-head"><strong>${esc(name)}</strong>${badge(p.status||'waiting')}</div><div class="platform-stats"><span>Views<b>${num(p.views)}</b></span><span>Likes<b>${num(p.likes)}</b></span><span>Comments<b>${num(p.comments)}</b></span></div><div class="sub">${num(p.tracked_media)} tracked · ${num(meaningful)} meaningful learning samples · Shares ${num(p.shares)}</div></div>`}).join('')}</div><p class="sub">Each platform learns independently at 24h, 72h and 168h. Unavailable metrics stay unknown; small samples cannot select winners.</p></article>`)}
function renderSystem(d){const s=d.system,sch=s.scheduler||{},sup=s.supervisor||{},metaSch=s.meta_scheduler||{},cert=s.certification||{},back=s.backup||{},runs=s.autopilot_runs||{},worked=s.last_worked||{};$('#systemGrid').innerHTML=card('Production gate',String(s.production_gate).toUpperCase(),s.production_gate==='closed'?'No new work can start':'Automation may run')+card('Windows task',sch.task_state||'unknown',`Last result: ${sch.last_result??'-'}`)+card('Last autopilot run',String(runs.status||'unknown').toUpperCase(),`${runs.started_at?'Started '+when(runs.started_at):'No run recorded'}${runs.finished_at?' - Finished '+when(runs.finished_at):''} - ${runs.run_id||''}`)+card('Scheduler verified',worked.scheduler_checked_at?when(worked.scheduler_checked_at):'unknown','Cert refresher last check')+card('Reconciliation',worked.reconciliation_checked_at?when(worked.reconciliation_checked_at):'never','Last release contract check')+card('Supervisor',sup.status||'unknown',`Manual actions: ${sup.normal_manual_actions??0}`)+card('Meta scheduler',metaSch.status||'unknown',`${esc(metaSch.health?.status||'unknown')} · no-overlap worker`)+card('Certification',cert.status||'unknown',`${num((cert.checks||[]).length)} checks · ${num((cert.failed_checks||[]).length)} failed`)+`<article class="card wide glass"><div class="section-title"><h3>Recovery contract</h3><span>Fail closed</span></div><dl class="kv"><dt>Wake to run</dt><dd>${sch.wake_to_run?'Yes':'No'}</dd><dt>Start when available</dt><dd>${sch.start_when_available?'Yes':'No'}</dd><dt>Retries</dt><dd>${num(sch.restart_count)} every ${esc(sch.restart_interval)}</dd><dt>Overlap policy</dt><dd>${esc(sch.multiple_instances)}</dd><dt>Active production processes</dt><dd>${num((sch.active_production_processes||[]).length)}</dd></dl></article>`+`<article class="card wide glass"><div class="section-title"><h3>Verified backup</h3>${badge(back.status)}</div><dl class="kv"><dt>Created</dt><dd>${when(back.created_at)}</dd><dt>Files</dt><dd>${num(back.file_count)}</dd><dt>Size</dt><dd>${(Number(back.size_bytes||0)/1048576).toFixed(2)} MB</dd><dt>Retention</dt><dd>${num(back.retention_days)} days</dd><dt>Off-device copy</dt><dd class="${back.off_device_copy?'good':'warn'}">${back.off_device_copy?'Configured':'Not configured'}</dd></dl></article>`+`<article class="card full glass"><div class="section-title"><h3>Safety guarantees</h3><span>Hard gates</span></div><div class="grid"><div class="card"><div class="good">✓</div><strong>No immediate public upload</strong><p class="sub">Private or future-scheduled only.</p></div><div class="card"><div class="good">✓</div><strong>Strict QC before release</strong><p class="sub">Identity, images, audio, captions, decode, rights and metadata.</p></div><div class="card"><div class="good">✓</div><strong>No duplicate release</strong><p class="sub">Episode and exact video hashes are locked.</p></div><div class="card"><div class="good">✓</div><strong>No invented analytics</strong><p class="sub">Unavailable retention remains visibly unknown.</p></div></div></article>`}
async function load(){try{const response=await fetch('/api/status',{cache:'no-store'});if(!response.ok)throw new Error(`HTTP ${response.status}`);const d=await response.json();$('#statusDot').className='dot '+d.studio.tone;$('#statusPill').textContent=d.studio.mode;$('#updated').textContent='Updated '+when(d.generated_at);$('#heroMode').textContent=d.studio.mode;$('#heroSummary').textContent=d.studio.summary;const n=d.studio.next_task;$('#nextAction').textContent=n?String(n.action).replaceAll('_',' ').toUpperCase():'No queued action';$('#nextDetail').textContent=n?`${n.series_id} · Episode ${n.episode} · ${n.episode_title||'Untitled'}`:'Control plane is clear';renderOverview(d);renderProduction(d);renderReleases(d);renderMetaReleases(d);renderPerformance(d);renderMetaPerformance(d);renderSystem(d)}catch(e){$('#statusPill').textContent='OFFLINE';$('#statusDot').className='dot red';$('#heroSummary').textContent='Dashboard server could not read the control plane.'}}
tabs();load();setInterval(load,5000);
</script>
