# ── Copy this file to ".env" and fill in your keys. Nothing here is required to
# ── do a dry run (TTS + video render work with zero paid keys), but uploading and
# ── LLM scripting need the relevant keys.

# ---- LLM (script + idea generation). OPTIONAL ----
# Recommended free option: Google Gemini API. OpenAI-compatible providers remain supported.
# Leave OPENAI_API_KEY blank to fall back to built-in templates (no LLM).
#
# OPTION A — Gemini (recommended free tier): create a key at
#   https://aistudio.google.com/apikey
#     LLM_PROVIDER=gemini
#     GEMINI_API_KEY=AIza...
#     GEMINI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER=gemini
LLM_FALLBACKS=gemini,groq,cerebras,deepseek,openai,qwen
LLM_TIMEOUT_SECONDS=35
LLM_MAX_RETRIES=1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite
#
# OPTION B — OpenAI (paid, ~<1 cent/video):
#     OPENAI_API_KEY=sk-...
#     OPENAI_BASE_URL=https://api.openai.com/v1
#     OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible fallbacks. Providers without keys are skipped.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Fast OpenAI-compatible alternatives (optional).
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Cerebras: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# ---- Stock footage / images. OPTIONAL (free key) ----
# Get one free at https://www.pexels.com/api/  -> hugely improves visuals.
# Without it, the pipeline renders clean gradient backgrounds instead.
PEXELS_API_KEY=

# ---- Premium voice. OPTIONAL ----
# Leave blank to use free edge-tts (recommended, great Hindi/Indian voices).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- YouTube upload. Needed only for auto-publish ----
# See README "YouTube setup". Put your OAuth client file at credentials/client_secret.json
# The first run opens a browser to authorize; token is cached at credentials/token.json
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/token.json
YOUTUBE_LOGIN_HINT=

# ---- Performance tracker / Google Sheets. OPTIONAL ----
# Create one blank Google Sheet, share it as Editor with the service-account
# email, then paste the ID from its URL. Local CSV tracking works without this.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account-youtube-tracker.json

# ---- Meta Facebook + Instagram automation. ONE-TIME SETUP ----
# Prefer the excluded token file created by configure_meta.py. A direct token
# environment variable is supported for managed hosts but must never be shared.
META_SYSTEM_USER_TOKEN_FILE=credentials/meta_system_user_token.txt
META_SYSTEM_USER_TOKEN=

# ---- Meta Facebook + Instagram automation. ONE-TIME SETUP ----
# Prefer the excluded token file created by configure_meta.py. A direct token
# environment variable is supported for managed hosts but must never be shared.
META_SYSTEM_USER_TOKEN_FILE=credentials/meta_system_user_token.txt
META_SYSTEM_USER_TOKEN=
